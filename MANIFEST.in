include CHANGELOG.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LICENSE
include README.md
include RELEASE_CHECKLIST.md
include SECURITY.md
include SUPPORT.md
recursive-include docs *.md
recursive-include examples *.md *.py .gitignore
recursive-exclude * __pycache__ *.py[cod]
prune .agentbus
prune .git
prune .pytest_cache
prune .venv
prune build
prune dist
prune runs
