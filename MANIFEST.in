include CHANGELOG.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LICENSE
include README.md
include RELEASE_CHECKLIST.md
include SECURITY.md
include SUPPORT.md
recursive-include syndra/studio_assets *
recursive-include docs *.md
prune docs/release-readiness
recursive-include examples *.md *.py .gitignore
include tests/fixtures/connected_repair_crash.py
recursive-exclude * __pycache__ *.py[cod]
prune .syndra
prune .agentbus
prune .git
prune .pytest_cache
prune .venv
prune build
prune dist
prune runs
