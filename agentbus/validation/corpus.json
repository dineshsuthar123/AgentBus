          "kind": "task",
          "query": "change calculate_total without breaking tests",
          "expected_paths": ["src/calculator.py"],
          "expected_minimum_results": 1,
          "expected_outputs": ["src/calculator.py", "tests/test_calculator.py"]
        }
      ]
    },
