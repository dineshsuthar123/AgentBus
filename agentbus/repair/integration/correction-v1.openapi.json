          "stripe_subscription": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stripe Subscription"
          }
        },
        "required": [
          "identity",
          "purchase_id",
          "payment_id",
          "account_id",
          "feature",
          "currency",
          "amount_minor",
