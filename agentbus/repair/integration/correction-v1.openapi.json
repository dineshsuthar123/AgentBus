        ],
        "title": "PurchaseRead",
        "type": "object"
      },
      "PurchaseState": {
        "additionalProperties": false,
        "properties": {
          "access_present": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Present"
          },
          "account_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "amount_minor": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000000000.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "cancellation": {
            "enum": [
              "none",
              "period_end",
              "immediate"
