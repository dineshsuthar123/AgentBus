              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "purchase_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
