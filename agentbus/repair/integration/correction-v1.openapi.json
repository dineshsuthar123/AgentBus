{
  "components": {
    "schemas": {
      "AccessVerification": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "method": {
            "const": "normal_authorization_path",
            "default": "normal_authorization_path",
            "title": "Method",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "operation_id": {
            "pattern": "^[a-f0-9]{32}$",
            "title": "Operation Id",
            "type": "string"
          },
          "reason": {
            "maxLength": 300,
            "title": "Reason",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "superseded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "status",
          "observed_at",
          "revision",
          "allowed",
          "reason"
        ],
        "title": "AccessVerification",
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "aggregate_serialization": {
            "title": "Aggregate Serialization",
            "type": "boolean"
          },
          "compensation": {
            "const": "unsupported",
            "default": "unsupported",
            "title": "Compensation",
            "type": "string"
          },
          "coordinated_external_payments": {
            "default": false,
            "title": "Coordinated External Payments",
            "type": "boolean"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "maximum_batch": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Maximum Batch",
            "type": "integer"
          },
          "normal_access_verification": {
            "title": "Normal Access Verification",
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "enum": [
                "read",
                "approve",
                "repair",
                "verify",
                "revoke"
              ],
              "type": "string"
            },
            "maxItems": 5,
            "title": "Permissions",
            "type": "array"
          },
          "principal": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Principal",
            "type": "string"
          },
          "receipt_retention": {
            "const": "indefinite",
            "default": "indefinite",
            "title": "Receipt Retention",
            "type": "string"
          },
          "semantic_receipts": {
            "title": "Semantic Receipts",
            "type": "boolean"
          },
          "workflow": {
            "const": "paid-purchase-access/v1",
            "default": "paid-purchase-access/v1",
            "title": "Workflow",
            "type": "string"
          }
        },
        "required": [
          "identity",
          "principal",
          "permissions",
          "aggregate_serialization",
          "semantic_receipts",
          "normal_access_verification",
          "maximum_batch"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "ConditionalOperation": {
        "additionalProperties": false,
        "properties": {
          "connection_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Connection Digest",
            "type": "string"
          },
          "deadline": {
            "format": "date-time",
            "title": "Deadline",
            "type": "string"
          },
          "effect": {
            "$ref": "#/components/schemas/Effect"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "logical_effect": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Logical Effect",
            "type": "string"
          },
          "operation_id": {
            "pattern": "^[a-f0-9]{32}$",
            "title": "Operation Id",
            "type": "string"
          },
          "payload_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Payload Digest",
            "type": "string"
          },
          "payment_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Payment Id",
            "type": "string"
          },
          "plan_id": {
            "pattern": "^[a-f0-9]{32}$",
            "title": "Plan Id",
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/ConnectedRepairPolicy"
          },
          "policy_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Policy Digest",
            "type": "string"
          },
          "protocol": {
            "const": "syndra.correction/v1",
            "default": "syndra.correction/v1",
            "title": "Protocol",
            "type": "string"
          },
          "purchase_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Purchase Id",
            "type": "string"
          },
          "workspace_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Workspace Digest",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "plan_id",
          "workspace_digest",
          "identity",
          "connection_digest",
          "policy",
          "policy_digest",
          "purchase_id",
          "payment_id",
          "expected_revision",
          "effect",
          "logical_effect",
          "deadline",
          "payload_digest"
        ],
        "title": "ConditionalOperation",
        "type": "object"
      },
      "ConnectedRepairPolicy": {
        "additionalProperties": false,
        "properties": {
          "access_authority": {
            "const": "application",
            "default": "application",
            "title": "Access Authority",
            "type": "string"
          },
          "dispute": {
            "const": "do_not_restore",
            "default": "do_not_restore",
            "title": "Dispute",
            "type": "string"
          },
          "effect": {
            "const": "grant_original_period_only",
            "default": "grant_original_period_only",
            "title": "Effect",
            "type": "string"
          },
          "expired_period": {
            "const": "investigate",
            "default": "investigate",
            "title": "Expired Period",
            "type": "string"
          },
          "history_authority": {
            "const": "application",
            "default": "application",
            "title": "History Authority",
            "type": "string"
          },
          "incident_end": {
            "format": "date-time",
            "title": "Incident End",
            "type": "string"
          },
          "incident_start": {
            "format": "date-time",
            "title": "Incident Start",
            "type": "string"
          },
          "maximum_age_seconds": {
            "default": 60,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Maximum Age Seconds",
            "type": "integer"
          },
          "maximum_writes": {
            "default": 1,
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Maximum Writes",
            "type": "integer"
          },
          "partial_refund": {
            "const": "investigate",
            "default": "investigate",
            "title": "Partial Refund",
            "type": "string"
          },
          "payment_authority": {
            "default": "application",
            "enum": [
              "application",
              "stripe"
            ],
            "title": "Payment Authority",
            "type": "string"
          },
          "requests_per_second": {
            "default": 2,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Requests Per Second",
            "type": "integer"
          },
          "verification": {
            "const": "normal_authorization_path",
            "default": "normal_authorization_path",
            "title": "Verification",
            "type": "string"
          },
          "version": {
            "const": "paid-purchase-access/v1",
            "default": "paid-purchase-access/v1",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "incident_start",
          "incident_end"
        ],
        "title": "ConnectedRepairPolicy",
        "type": "object"
      },
      "Effect": {
        "additionalProperties": false,
        "properties": {
          "access_present": {
            "const": true,
            "default": true,
            "title": "Access Present",
            "type": "boolean"
          },
          "account_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Account Id",
            "type": "string"
          },
          "feature": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Feature",
            "type": "string"
          },
          "period_end": {
            "format": "date-time",
            "title": "Period End",
            "type": "string"
          },
          "period_start": {
            "format": "date-time",
            "title": "Period Start",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "feature",
          "period_start",
          "period_end"
        ],
        "title": "Effect",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
