      "PurchasePage": {
        "additionalProperties": false,
        "properties": {
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "next_cursor": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
