            "type": "string"
          },
          "disputed": {
            "title": "Disputed",
            "type": "boolean"
          },
          "evidence_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "feature": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Feature",
            "type": "string"
          },
          "history_complete": {
            "title": "History Complete",
            "type": "boolean"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "mapping_verified": {
            "title": "Mapping Verified",
            "type": "boolean"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "payment_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Payment Id",
            "type": "string"
          },
          "payment_state": {
            "enum": [
              "paid",
              "authorized",
              "pending",
              "failed",
              "cancelled",
              "unknown"
            ],
            "title": "Payment State",
            "type": "string"
          },
          "pending_payment_change": {
            "title": "Pending Payment Change",
            "type": "boolean"
          },
          "period_end": {
            "format": "date-time",
            "title": "Period End",
            "type": "string"
          },
          "period_start": {
            "format": "date-time",
            "title": "Period Start",
            "type": "string"
          },
          "purchase_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
            "title": "Purchase Id",
            "type": "string"
          },
          "purchased_at": {
            "format": "date-time",
            "title": "Purchased At",
            "type": "string"
          },
          "refunded_minor": {
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Refunded Minor",
            "type": "integer"
          },
          "restriction": {
            "enum": [
              "none",
              "suspended",
              "deleted",
              "manual_override",
              "changed_product"
            ],
            "title": "Restriction",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "stripe_customer": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stripe Customer"
          },
          "stripe_feature": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stripe Feature"
          },
          "stripe_invoice": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stripe Invoice"
          },
          "stripe_product": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stripe Product"
