        },
        {
          "id": "agentbus.impact",
          "name": "Impact Analysis"
        },
        {
          "id": "agentbus.contextPlan",
          "name": "Context Plan"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentbus.refresh",
          "when": "view =~ /agentbus\\./",
          "group": "navigation"
        },
        {
          "command": "agentbus.buildRepositoryIndex",
          "when": "view == agentbus.intelligence",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.updateRepositoryIndex",
          "when": "view == agentbus.intelligence",
          "group": "navigation@2"
        },
        {
          "command": "agentbus.verifyRepositoryIndex",
          "when": "view == agentbus.intelligence",
          "group": "navigation@3"
        },
        {
          "command": "agentbus.searchRepository",
          "when": "view == agentbus.symbols",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.analyzeChangeImpact",
          "when": "view == agentbus.impact",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.previewAgentContext",
          "when": "view == agentbus.contextPlan",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentbus.showRun",
          "when": "viewItem =~ /agentbusRun.*/",
          "group": "inline"
        },
        {
          "command": "agentbus.showSpan",
          "when": "viewItem == agentbusTraceSpan",
          "group": "inline"
        },
        {
          "command": "agentbus.showReplaySession",
          "when": "viewItem == agentbusReplayCancellable || viewItem == agentbusReplayTerminal",
          "group": "inline"
        },
        {
          "command": "agentbus.cancelReplay",
          "when": "viewItem == agentbusReplayCancellable",
          "group": "inline@2"
        },
        {
          "command": "agentbus.showComparison",
          "when": "viewItem == agentbusComparison || viewItem == agentbusComparisonSpan",
          "group": "inline"
        },
        {
          "command": "agentbus.openStructuredReplayDifferences",
          "when": "viewItem == agentbusComparison || viewItem == agentbusComparisonSpan",
          "group": "navigation"
        },
        {
          "command": "agentbus.cancelRun",
          "when": "viewItem == agentbusRunCancellable",
          "group": "inline@2"
        },
        {
          "command": "agentbus.replayRunOffline",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation"
        },
        {
          "command": "agentbus.replayFromCheckpoint",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@2"
        },
        {
          "command": "agentbus.forkRun",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@3"
        },
        {
          "command": "agentbus.exportTrace",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@4"
        },
        {
          "command": "agentbus.captureRegressionFixture",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@5"
        },
        {
          "command": "agentbus.openProvenanceManifest",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@6"
        },
        {
          "command": "agentbus.approveAction",
          "when": "viewItem == agentbusApprovalPending",
          "group": "inline"
        },
        {
          "command": "agentbus.rejectAction",
          "when": "viewItem == agentbusApprovalPending",
          "group": "inline"
        },
        {
          "command": "agentbus.showToolInvocation",
          "when": "viewItem == agentbusToolCancellable || viewItem == agentbusToolTerminal",
          "group": "inline"
        },
        {
          "command": "agentbus.cancelToolInvocation",
          "when": "viewItem == agentbusToolCancellable",
          "group": "inline@2"
        },
        {
          "command": "agentbus.openToolArtifact",
          "when": "viewItem == agentbusToolCancellable || viewItem == agentbusToolTerminal",
          "group": "navigation"
        },
        {
          "command": "agentbus.showMcpServer",
          "when": "viewItem == agentbusMcpServer",
          "group": "inline"
        },
        {
          "command": "agentbus.checkMcpServer",
          "when": "viewItem == agentbusMcpServer",
          "group": "inline@2"
        },
        {
          "command": "agentbus.buildRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.updateRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "agentbus.verifyRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "agentbus.repairRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@4"
        },
        {
          "command": "agentbus.cancelRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@5"
        },
        {
          "command": "agentbus.showRepositoryDependencies",
          "when": "viewItem == agentbusRepositorySymbol",
          "group": "inline@1"
        },
        {
          "command": "agentbus.showRepositoryDependents",
          "when": "viewItem == agentbusRepositorySymbol",
          "group": "inline@2"
        },
        {
          "command": "agentbus.analyzeChangeImpact",
          "when": "viewItem == agentbusRepositorySymbol",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.openArchitectureBoundary",
          "when": "viewItem == agentbusRepositoryBoundary || viewItem == agentbusRepositoryOwnership",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "AgentBus",
      "properties": {
        "agentbus.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted AgentBus executable. Leave empty to use the Python path or the agentbus command from PATH."
        },
        "agentbus.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted Python executable used with -m agentbus.cli when no AgentBus executable path is set."
        },
        "agentbus.configPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted AgentBus JSON or TOML configuration file. Explicit CLI values and environment variables retain their documented precedence."
        },
        "agentbus.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Start a loopback-only AgentBus daemon when no compatible daemon is available. Startup is always blocked in untrusted workspaces."
        },
        "agentbus.defaultProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "azure",
            "deterministic"
          ],
          "default": "deterministic",
          "description": "Provider selected for new tasks. Deterministic is built in and network-free; live providers require separate explicit configuration."
        },
        "agentbus.defaultWorkflow": {
          "type": "string",
          "enum": [
            "single",
            "multi"
          ],
          "default": "multi",
          "description": "Use the single-agent or planner/coder/verifier/reviewer workflow for new tasks."
        },
        "agentbus.defaultDurable": {
          "type": "boolean",
          "default": true,
          "description": "Persist new task execution so interrupted runs can be inspected and resumed safely."
        },
        "agentbus.defaultParallel": {
          "type": "boolean",
          "default": false,
          "description": "Allow independent durable graph tasks to run concurrently within the configured worker bound."
        },
        "agentbus.maxWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 4,
          "description": "Maximum number of bounded durable workers used for parallel graph execution."
        },
        "agentbus.keepWorktrees": {
          "type": "boolean",
          "default": true,
          "description": "Retain AgentBus-owned task worktrees for inspection after completion; cleanup remains explicit."
        },
        "agentbus.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "Minimum severity written to the bounded local daemon log."
        },
        "agentbus.registryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the trusted local daemon metadata registry. Authentication tokens remain in VS Code SecretStorage and are never written here."
        },
        "agentbus.showWelcomeOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Show the concise AgentBus onboarding prompt once for each supported product minor release."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "node scripts/clean-output.mjs && tsc -p .",
    "watch": "tsc -p . --watch",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run compile && node --test out/test/*.test.js scripts/audit-vsix.test.mjs",
    "test:integration": "npm run compile && node out/test/runIntegration.js",
    "protocol:check": "node scripts/check-protocol.mjs",
    "package": "npm run compile && vsce package --no-dependencies -o agentbus-vscode.vsix",
    "package:audit": "node scripts/audit-vsix.mjs agentbus-vscode.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.30.0",
    "jszip": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
