{
  "name": "agentbus-vscode",
  "displayName": "AgentBus",
  "description": "Native local control-plane integration for AgentBus",
  "version": "0.6.0-beta.1",
  "publisher": "agentbus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dineshsuthar123/AgentBus.git"
  },
  "private": true,
  "agentbusCompatibility": {
    "python": ">=0.6.0b1,<0.7.0",
    "controlProtocol": "1.0",
    "stateSchema": 6
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "agentbus",
    "agents",
    "local",
    "developer tools"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:agentbus.runs",
    "onView:agentbus.timeline",
    "onView:agentbus.replays",
    "onView:agentbus.comparisons",
    "onView:agentbus.tools",
    "onView:agentbus.mcp",
    "onView:agentbus.intelligence",
    "onView:agentbus.symbols",
    "onView:agentbus.impact",
    "onView:agentbus.contextPlan",
    "onCommand:agentbus.startTask"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentbus.startTask",
        "title": "AgentBus: Start Task"
      },
      {
        "command": "agentbus.startDurableTask",
        "title": "AgentBus: Start Durable Task"
      },
      {
        "command": "agentbus.startParallelTask",
        "title": "AgentBus: Start Parallel Task"
      },
      {
        "command": "agentbus.resumeRun",
        "title": "AgentBus: Resume Run"
      },
      {
        "command": "agentbus.cancelRun",
        "title": "AgentBus: Cancel Run"
      },
      {
        "command": "agentbus.showRun",
        "title": "AgentBus: Show Run"
      },
      {
        "command": "agentbus.showExecutionTimeline",
        "title": "AgentBus: Show Execution Timeline"
      },
      {
        "command": "agentbus.showSpan",
        "title": "AgentBus: Show Span"
      },
      {
        "command": "agentbus.showReplaySession",
        "title": "AgentBus: Show Replay Session"
      },
      {
        "command": "agentbus.compareRuns",
        "title": "AgentBus: Compare Runs"
      },
      {
        "command": "agentbus.showComparison",
        "title": "AgentBus: Show Comparison"
      },
      {
        "command": "agentbus.openStructuredReplayDifferences",
        "title": "AgentBus: Open Structured Replay Differences"
      },
      {
        "command": "agentbus.compareRunReports",
        "title": "AgentBus: Compare Run Reports"
      },
      {
        "command": "agentbus.replayRunOffline",
        "title": "AgentBus: Replay Run Offline"
      },
      {
        "command": "agentbus.replayFromCheckpoint",
        "title": "AgentBus: Replay from Checkpoint"
      },
      {
        "command": "agentbus.forkRun",
        "title": "AgentBus: Fork Run"
      },
      {
        "command": "agentbus.exportTrace",
        "title": "AgentBus: Export Trace"
      },
      {
        "command": "agentbus.importTrace",
        "title": "AgentBus: Import Trace"
      },
      {
        "command": "agentbus.captureRegressionFixture",
        "title": "AgentBus: Capture Regression Fixture"
      },
      {
        "command": "agentbus.openProvenanceManifest",
        "title": "AgentBus: Open Provenance Manifest"
      },
      {
        "command": "agentbus.cancelReplay",
        "title": "AgentBus: Cancel Replay"
      },
      {
        "command": "agentbus.openRunReport",
        "title": "AgentBus: Open Run Report"
      },
      {
        "command": "agentbus.openChanges",
        "title": "AgentBus: Open Changes"
      },
      {
        "command": "agentbus.showToolInvocation",
        "title": "AgentBus: Show Tool Invocation"
      },
      {
        "command": "agentbus.cancelToolInvocation",
        "title": "AgentBus: Cancel Tool Invocation"
      },
      {
        "command": "agentbus.openToolArtifact",
        "title": "AgentBus: Open Tool Artifact"
      },
      {
        "command": "agentbus.showToolPolicy",
        "title": "AgentBus: Show Tool Policy"
      },
      {
        "command": "agentbus.refreshToolRegistry",
        "title": "AgentBus: Refresh Tool Registry"
      },
      {
        "command": "agentbus.checkMcpServer",
        "title": "AgentBus: Check MCP Server"
      },
      {
        "command": "agentbus.buildRepositoryIndex",
        "title": "AgentBus: Build Repository Index"
      },
      {
        "command": "agentbus.updateRepositoryIndex",
        "title": "AgentBus: Update Repository Index"
      },
      {
        "command": "agentbus.verifyRepositoryIndex",
        "title": "AgentBus: Verify Repository Index"
      },
      {
        "command": "agentbus.repairRepositoryIndex",
        "title": "AgentBus: Repair Repository Index"
      },
      {
        "command": "agentbus.cancelRepositoryIndex",
        "title": "AgentBus: Cancel Repository Index"
      },
      {
        "command": "agentbus.searchRepository",
        "title": "AgentBus: Search Repository"
      },
      {
        "command": "agentbus.findRepositorySymbol",
        "title": "AgentBus: Find Symbol"
      },
      {
        "command": "agentbus.openRepositorySymbol",
        "title": "AgentBus: Open Repository Symbol"
      },
      {
        "command": "agentbus.showRepositoryDependencies",
        "title": "AgentBus: Show Dependencies"
      },
      {
        "command": "agentbus.showRepositoryDependents",
        "title": "AgentBus: Show Dependents"
      },
      {
        "command": "agentbus.analyzeChangeImpact",
        "title": "AgentBus: Analyze Change Impact"
      },
      {
        "command": "agentbus.findRelevantTests",
        "title": "AgentBus: Find Relevant Tests"
      },
      {
        "command": "agentbus.previewAgentContext",
        "title": "AgentBus: Preview Agent Context"
      },
      {
        "command": "agentbus.openArchitectureBoundary",
        "title": "AgentBus: Open Architecture Boundary"
      },
      {
        "command": "agentbus.showMcpServer",
        "title": "AgentBus: Show MCP Server"
      },
      {
        "command": "agentbus.approveAction",
        "title": "AgentBus: Approve Action"
      },
      {
        "command": "agentbus.rejectAction",
        "title": "AgentBus: Reject Action"
      },
      {
        "command": "agentbus.runDoctor",
        "title": "AgentBus: Run Doctor"
      },
      {
        "command": "agentbus.selectProvider",
        "title": "AgentBus: Select Provider"
      },
      {
        "command": "agentbus.restartDaemon",
        "title": "AgentBus: Restart Daemon"
      },
      {
        "command": "agentbus.stopDaemon",
        "title": "AgentBus: Stop Daemon"
      },
      {
        "command": "agentbus.openLogs",
        "title": "AgentBus: Open Logs"
      },
      {
        "command": "agentbus.refresh",
        "title": "AgentBus: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentbus",
          "title": "AgentBus",
          "icon": "media/agentbus.svg"
        }
      ]
    },
    "views": {
      "agentbus": [
        {
          "id": "agentbus.runs",
          "name": "Runs"
        },
        {
          "id": "agentbus.tasks",
          "name": "Run Tasks"
        },
        {
          "id": "agentbus.timeline",
          "name": "Execution Timeline"
        },
        {
          "id": "agentbus.replays",
          "name": "Replay Sessions"
        },
        {
          "id": "agentbus.comparisons",
          "name": "Comparisons"
        },
        {
          "id": "agentbus.approvals",
          "name": "Approvals"
        },
        {
          "id": "agentbus.tools",
          "name": "Tool Invocations"
        },
        {
          "id": "agentbus.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "agentbus.providers",
          "name": "Providers"
        },
        {
          "id": "agentbus.mcp",
          "name": "MCP Servers"
        },
        {
          "id": "agentbus.intelligence",
          "name": "Repository Intelligence"
        },
        {
          "id": "agentbus.symbols",
          "name": "Symbol Explorer"
        },
        {
          "id": "agentbus.impact",
          "name": "Impact Analysis"
        },
        {
          "id": "agentbus.contextPlan",
          "name": "Context Plan"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentbus.refresh",
          "when": "view =~ /agentbus\\./",
          "group": "navigation"
        },
        {
          "command": "agentbus.buildRepositoryIndex",
          "when": "view == agentbus.intelligence",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.updateRepositoryIndex",
          "when": "view == agentbus.intelligence",
          "group": "navigation@2"
        },
        {
          "command": "agentbus.verifyRepositoryIndex",
          "when": "view == agentbus.intelligence",
          "group": "navigation@3"
        },
        {
          "command": "agentbus.searchRepository",
          "when": "view == agentbus.symbols",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.analyzeChangeImpact",
          "when": "view == agentbus.impact",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.previewAgentContext",
          "when": "view == agentbus.contextPlan",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentbus.showRun",
          "when": "viewItem =~ /agentbusRun.*/",
          "group": "inline"
        },
        {
          "command": "agentbus.showSpan",
          "when": "viewItem == agentbusTraceSpan",
          "group": "inline"
        },
        {
          "command": "agentbus.showReplaySession",
          "when": "viewItem == agentbusReplayCancellable || viewItem == agentbusReplayTerminal",
          "group": "inline"
        },
        {
          "command": "agentbus.cancelReplay",
          "when": "viewItem == agentbusReplayCancellable",
          "group": "inline@2"
        },
        {
          "command": "agentbus.showComparison",
          "when": "viewItem == agentbusComparison || viewItem == agentbusComparisonSpan",
          "group": "inline"
        },
        {
          "command": "agentbus.openStructuredReplayDifferences",
          "when": "viewItem == agentbusComparison || viewItem == agentbusComparisonSpan",
          "group": "navigation"
        },
        {
          "command": "agentbus.cancelRun",
          "when": "viewItem == agentbusRunCancellable",
          "group": "inline@2"
        },
        {
          "command": "agentbus.replayRunOffline",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation"
        },
        {
          "command": "agentbus.replayFromCheckpoint",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@2"
        },
        {
          "command": "agentbus.forkRun",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@3"
        },
        {
          "command": "agentbus.exportTrace",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@4"
        },
        {
          "command": "agentbus.captureRegressionFixture",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@5"
        },
        {
          "command": "agentbus.openProvenanceManifest",
          "when": "viewItem == agentbusRunTerminal",
          "group": "navigation@6"
        },
        {
          "command": "agentbus.approveAction",
          "when": "viewItem == agentbusApprovalPending",
          "group": "inline"
        },
        {
          "command": "agentbus.rejectAction",
          "when": "viewItem == agentbusApprovalPending",
          "group": "inline"
        },
        {
          "command": "agentbus.showToolInvocation",
          "when": "viewItem == agentbusToolCancellable || viewItem == agentbusToolTerminal",
          "group": "inline"
        },
        {
          "command": "agentbus.cancelToolInvocation",
          "when": "viewItem == agentbusToolCancellable",
          "group": "inline@2"
        },
        {
          "command": "agentbus.openToolArtifact",
          "when": "viewItem == agentbusToolCancellable || viewItem == agentbusToolTerminal",
          "group": "navigation"
        },
        {
          "command": "agentbus.showMcpServer",
          "when": "viewItem == agentbusMcpServer",
          "group": "inline"
        },
        {
          "command": "agentbus.checkMcpServer",
          "when": "viewItem == agentbusMcpServer",
          "group": "inline@2"
        },
        {
          "command": "agentbus.buildRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.updateRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "agentbus.verifyRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "agentbus.repairRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@4"
        },
        {
          "command": "agentbus.cancelRepositoryIndex",
          "when": "viewItem == agentbusIntelligenceWorkspace",
          "group": "navigation@5"
        },
        {
          "command": "agentbus.showRepositoryDependencies",
          "when": "viewItem == agentbusRepositorySymbol",
          "group": "inline@1"
        },
        {
          "command": "agentbus.showRepositoryDependents",
          "when": "viewItem == agentbusRepositorySymbol",
          "group": "inline@2"
        },
        {
          "command": "agentbus.analyzeChangeImpact",
          "when": "viewItem == agentbusRepositorySymbol",
          "group": "navigation@1"
        },
        {
          "command": "agentbus.openArchitectureBoundary",
          "when": "viewItem == agentbusRepositoryBoundary || viewItem == agentbusRepositoryOwnership",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "AgentBus",
      "properties": {
        "agentbus.executablePath": {
          "type": "string",
          "default": "",
          "description": "Explicit AgentBus executable path."
        },
        "agentbus.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable used with -m agentbus.cli when no AgentBus executable is set."
        },
        "agentbus.configPath": {
          "type": "string",
          "default": "",
          "description": "Explicit AgentBus JSON or TOML configuration file passed to the local daemon."
        },
        "agentbus.autoStartDaemon": {
          "type": "boolean",
          "default": true
        },
        "agentbus.defaultProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "azure",
            "deterministic"
          ],
          "default": "ollama"
        },
        "agentbus.defaultWorkflow": {
          "type": "string",
          "enum": [
            "single",
            "multi"
          ],
          "default": "multi"
        },
        "agentbus.defaultDurable": {
          "type": "boolean",
          "default": true
        },
        "agentbus.defaultParallel": {
          "type": "boolean",
          "default": false
        },
        "agentbus.maxWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 4
        },
        "agentbus.keepWorktrees": {
          "type": "boolean",
          "default": true
        },
        "agentbus.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning"
        },
        "agentbus.registryPath": {
          "type": "string",
          "default": "",
          "description": "Optional daemon registry path. This file contains metadata only, never tokens."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "node scripts/clean-output.mjs && tsc -p .",
    "watch": "tsc -p . --watch",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run compile && node --test out/test/*.test.js scripts/audit-vsix.test.mjs",
    "test:integration": "npm run compile && node out/test/runIntegration.js",
    "protocol:check": "node scripts/check-protocol.mjs",
    "package": "npm run compile && vsce package --no-dependencies -o agentbus-vscode.vsix",
    "package:audit": "node scripts/audit-vsix.mjs agentbus-vscode.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.30.0",
    "jszip": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
