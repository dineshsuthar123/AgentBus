    "walkthroughs": [
      {
        "id": "agentbus.gettingStarted",
        "title": "Get Started with AgentBus",
        "description": "Install, verify, and run a complete network-free AgentBus task.",
        "steps": [
          {
            "id": "agentbus.gettingStarted.check",
            "title": "Check the installation",
            "description": "Run [AgentBus: Check Installation](command:agentbus.checkInstallation) for offline package, compatibility, repository, and environment diagnostics.",
            "completionEvents": [
              "onCommand:agentbus.checkInstallation"
            ]
          },
          {
            "id": "agentbus.gettingStarted.setup",
            "title": "Configure safe defaults",
            "description": "Run [AgentBus: Run Setup](command:agentbus.runSetup) to configure the deterministic provider and local runtime without contacting a live service.",
            "completionEvents": [
              "onCommand:agentbus.runSetup"
            ]
          },
          {
            "id": "agentbus.gettingStarted.quickstart",
            "title": "Complete an offline first task",
            "description": "Run [AgentBus: Run Quickstart](command:agentbus.runQuickstart) in a temporary demo repository. AgentBus cleans its temporary state when the run finishes.",
            "completionEvents": [
              "onCommand:agentbus.runQuickstart"
            ]
          },
          {
            "id": "agentbus.gettingStarted.configuration",
            "title": "Inspect resolved configuration",
            "description": "Open [resolved safe configuration](command:agentbus.openResolvedConfiguration) with source precedence and credential values redacted.",
            "completionEvents": [
              "onCommand:agentbus.openResolvedConfiguration"
            ]
          },
          {
            "id": "agentbus.gettingStarted.docs",
            "title": "Learn the workflows",
            "description": "Open the [AgentBus documentation](command:agentbus.openDocumentation) for installation, repository indexing, task, replay, and troubleshooting workflows.",
            "completionEvents": [
              "onCommand:agentbus.openDocumentation"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentbus",
          "title": "AgentBus",
          "icon": "media/agentbus.svg"
        }
      ]
    },
    "views": {
      "agentbus": [
        {
          "id": "agentbus.runs",
          "name": "Runs"
        },
        {
          "id": "agentbus.tasks",
          "name": "Run Tasks"
        },
        {
          "id": "agentbus.timeline",
          "name": "Execution Timeline"
        },
        {
          "id": "agentbus.replays",
          "name": "Replay Sessions"
        },
        {
